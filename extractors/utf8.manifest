<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Makes UTF-8 the code page of the tools on Windows 10 1903 and newer, so that
  file names with non-ASCII characters reach Essentia, FFmpeg and ONNX Runtime
  intact. They expect UTF-8, the default code page only covers some characters.
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
